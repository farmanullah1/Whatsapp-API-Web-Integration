# --- Server ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# Required. At least 16 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=change-me-to-a-long-random-string

# --- WhatsApp session ---
CLIENT_ID=default
SESSION_DIR=./.wwebjs_auth
# Numbers starting with 0 get this prefix (03001234567 -> 923001234567). Leave empty to disable.
DEFAULT_COUNTRY_CODE=92
HEADLESS=true
# Optional: use an installed Chrome instead of the bundled Chromium
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Sending ---
# Minimum gap between messages + random jitter (protects your number from spam bans)
SEND_DELAY_MS=1000
SEND_JITTER_MS=500
SEND_TIMEOUT_MS=30000
MAX_QUEUE_SIZE=1000
MAX_BODY_SIZE=25mb
RATE_LIMIT_PER_MINUTE=120
WATCHDOG_INTERVAL_MS=60000

# --- Incoming messages / delivery receipts (optional) ---
WEBHOOK_URL=
WEBHOOK_SECRET=
